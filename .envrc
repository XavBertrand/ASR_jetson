# Repo-local GPU runtime environment.
# Applied only inside this repository when using direnv.

if [ -d "$PWD/.venv" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"

  _ASR_JETSON_CUDA_LIBS="$VIRTUAL_ENV/lib/python3.11/site-packages/nvidia/cudnn/lib:$VIRTUAL_ENV/lib/python3.11/site-packages/nvidia/cublas/lib:$VIRTUAL_ENV/lib/python3.11/site-packages/nvidia/cuda_runtime/lib"
  if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    export LD_LIBRARY_PATH="$_ASR_JETSON_CUDA_LIBS:$LD_LIBRARY_PATH"
  else
    export LD_LIBRARY_PATH="$_ASR_JETSON_CUDA_LIBS"
  fi
  unset _ASR_JETSON_CUDA_LIBS
fi
